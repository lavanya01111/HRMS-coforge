@model IEnumerable<HRMS.ViewModels.Department.DepartmentViewModel>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">Departments</h2>
        <p class="text-muted mb-0">Manage company divisions, teams, and organizational units.</p>
    </div>

    <a asp-action="Create" class="btn-hrms-primary">
        <i class="bi bi-building-add me-1"></i> Add Department
    </a>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">All Departments</h5>
            <small class="text-muted">Active organizational units</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Departments</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Department</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-mint" style="width: 36px; height: 36px; font-size: 16px;">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <span class="fw-bold">@department.DepartmentName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary">
                                    @(string.IsNullOrEmpty(department.Description) ? "No description provided" : department.Description)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@department.DepartmentId"
                                       class="btn-hrms-soft btn-sm"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@department.DepartmentId"
                                       class="btn-hrms-soft btn-sm"
                                       title="Edit Department">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@department.DepartmentId"
                                       class="btn-hrms-danger-soft btn-sm"
                                       title="Delete Department">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            No departments found. Click "Add Department" to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>