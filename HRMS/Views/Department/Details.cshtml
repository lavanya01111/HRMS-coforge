@model HRMS.ViewModels.Department.DepartmentViewModel

@{
    ViewData["Title"] = "Department Details";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Department Details</h2>
            <p class="text-muted mb-0">Overview of organizational unit attributes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn-hrms-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn-hrms-outline">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="hrms-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--hrms-card-border) !important;">
                <div class="stat-icon-wrap stat-icon-mint" style="width: 52px; height: 52px; font-size: 24px;">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@Model.DepartmentName</h4>
                    <span class="badge-hrms badge-role">Active Department</span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-muted small text-uppercase fw-bold">Department Description</label>
                <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                    <p class="mb-0 text-secondary">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>