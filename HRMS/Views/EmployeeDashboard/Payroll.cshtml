@model IEnumerable<HRMS.Models.Payroll>

@{
    ViewData["Title"] = "My Payroll";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">My Payroll & Salary</h2>
        <p class="text-muted mb-0">
            View your earnings statements, allowances, and monthly compensation details.
        </p>
    </div>

    <a asp-controller="EmployeeDashboard"
       asp-action="Index"
       class="btn-hrms-outline">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">Salary Statements</h5>
            <small class="text-muted">Itemized compensation breakdown</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Payslips</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Salary Month</th>
                        <th>Basic Salary</th>
                        <th>Allowance</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payroll in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-peach" style="width: 32px; height: 32px; font-size: 14px;">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <span class="fw-bold">@payroll.SalaryMonth.ToString("MMMM yyyy")</span>
                                </div>
                            </td>
                            <td>₹@payroll.BasicSalary.ToString("N2")</td>
                            <td class="text-success">+₹@payroll.Allowance.ToString("N2")</td>
                            <td class="text-danger">-₹@payroll.Deduction.ToString("N2")</td>
                            <td>
                                <span class="badge-hrms badge-approved fs-6">
                                    ₹@payroll.NetSalary.ToString("N2")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrap stat-icon-peach mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h5 class="fw-bold mb-1">No Payroll Records Yet</h5>
            <p class="text-muted small mb-0">
                Your monthly salary statements will appear here once generated by HR.
            </p>
        </div>
    }
</div>