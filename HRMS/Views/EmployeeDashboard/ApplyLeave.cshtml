@model HRMS.ViewModels.LeaveRequest.LeaveRequestViewModel

@{
    ViewData["Title"] = "Apply for Leave";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Apply for Leave</h2>
            <p class="text-muted mb-0">Submit your leave request for manager review.</p>
        </div>
        <a asp-action="Leaves" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> My Leave Requests
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="hrms-card p-4 p-md-5 mb-4">

            <form asp-action="ApplyLeave" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 px-3 mb-4 small"
                     role="alert">
                </div>

                <!-- Leave Type -->
                <div class="mb-4">
                    <label asp-for="LeaveType" class="form-label">
                        Leave Type
                    </label>
                    <select asp-for="LeaveType" class="form-select">
                        <option value="">Select leave type</option>
                        <option value="Casual">Casual Leave (Personal Time Off)</option>
                        <option value="Sick">Sick Leave (Medical Recovery)</option>
                        <option value="Earned">Earned / Annual Leave (Vacation)</option>
                    </select>
                    <span asp-validation-for="LeaveType" class="text-danger small"></span>
                </div>

                <!-- Dates Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">
                            Start Date
                        </label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">
                            End Date
                        </label>
                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Reason -->
                <div class="mb-4">
                    <label asp-for="Reason" class="form-label">
                        Reason for Leave
                    </label>
                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="4"
                              placeholder="Enter reason for your leave request..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex align-items-center gap-3 pt-2">
                    <button type="submit"
                            class="btn-hrms-primary px-4 py-3">
                        <i class="bi bi-send-check me-1"></i> Submit Request
                    </button>

                    <a asp-action="Leaves"
                       class="btn-hrms-outline px-4 py-3">
                        Cancel
                    </a>
                </div>

            </form>

        </div>


        <!-- CUTE BOTTOM CARD (MATCHING REFERENCE IMAGE 2) -->
        <div class="motivational-card p-4">
            <div class="stat-icon-wrap stat-icon-pink" style="width: 52px; height: 52px; font-size: 24px;">
                <i class="bi bi-calendar2-heart"></i>
            </div>
            <div>
                <h5 class="font-serif fw-bold mb-1">
                    Take time to recharge.
                </h5>
                <p class="text-muted small mb-0">
                    A balanced you, builds a better tomorrow. We support your rest and wellbeing. ♡
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}