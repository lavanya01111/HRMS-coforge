@model IEnumerable<HRMS.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leaves";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">My Leaves</h2>
        <p class="text-muted mb-0">
            View your time-off history and check real-time approval status.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="EmployeeDashboard"
           asp-action="ApplyLeave"
           class="btn-hrms-primary">
            <i class="bi bi-plus-circle me-1"></i> Apply for Leave
        </a>
        <a asp-action="Index" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>
</div>

<div class="hrms-table-container p-0 mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">Leave Requests History</h5>
            <small class="text-muted">Track your submitted requests</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Total Requests</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-pink" style="width: 32px; height: 32px; font-size: 14px;">
                                        <i class="bi bi-calendar-heart"></i>
                                    </div>
                                    <span class="fw-semibold">@leave.LeaveType</span>
                                </div>
                            </td>
                            <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="text-secondary" style="max-width: 260px; display: inline-block;">
                                    @leave.Reason
                                </span>
                            </td>
                            <td>
                                @if (leave.Status == "Approved")
                                {
                                    <span class="badge-hrms badge-approved">
                                        <i class="bi bi-check-circle-fill"></i> Approved
                                    </span>
                                }
                                else if (leave.Status == "Rejected")
                                {
                                    <span class="badge-hrms badge-rejected">
                                        <i class="bi bi-x-circle-fill"></i> Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-hrms badge-pending">
                                        <i class="bi bi-clock-fill"></i> Pending Review
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrap stat-icon-pink mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h5 class="fw-bold mb-1">No Leave Requests Found</h5>
            <p class="text-muted small mb-3">You haven't requested any time off yet.</p>
            <a asp-controller="EmployeeDashboard" asp-action="ApplyLeave" class="btn-hrms-primary">
                Submit Your First Request
            </a>
        </div>
    }
</div>