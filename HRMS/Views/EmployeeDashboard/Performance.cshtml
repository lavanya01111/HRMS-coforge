@model IEnumerable<HRMS.Models.PerformanceReview>

@{
    ViewData["Title"] = "My Performance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">My Performance Reviews</h2>
        <p class="text-muted mb-0">
            View your evaluations, ratings, milestones and manager feedback.
        </p>
    </div>

    <a asp-controller="EmployeeDashboard"
       asp-action="Index"
       class="btn-hrms-outline">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

<div class="hrms-table-container p-0 mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">Evaluation History</h5>
            <small class="text-muted">Structured feedback & scoring</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Reviews</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Review Date</th>
                        <th>Rating</th>
                        <th>Manager Comments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-lavender" style="width: 32px; height: 32px; font-size: 14px;">
                                        <i class="bi bi-star"></i>
                                    </div>
                                    <span class="fw-semibold">@review.ReviewDate.ToString("dd MMMM yyyy")</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge-hrms badge-approved">
                                        ★ @review.Rating / 5
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary">
                                    @(string.IsNullOrEmpty(review.Comments) ? "Great progress and steady contribution!" : review.Comments)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrap stat-icon-lavender mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
                <i class="bi bi-award"></i>
            </div>
            <h5 class="fw-bold mb-1">No Performance Reviews Yet</h5>
            <p class="text-muted small mb-0">
                Your performance evaluations will appear here once submitted by your manager.
            </p>
        </div>
    }
</div>

<!-- Bottom Motivational Card -->
<div class="motivational-card p-4">
    <div class="stat-icon-wrap stat-icon-pink" style="width: 52px; height: 52px; font-size: 24px;">
        <i class="bi bi-trophy"></i>
    </div>
    <div>
        <h5 class="font-serif fw-bold mb-1">
            Continuous Growth & Learning
        </h5>
        <p class="text-muted small mb-0">
            Every review is an opportunity to celebrate wins, identify new strengths, and reach for higher horizons. ♡
        </p>
    </div>
</div>