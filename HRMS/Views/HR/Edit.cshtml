@model HRMS.Data.ApplicationUser

@{
    ViewData["Title"] = "Edit HR Account";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Edit HR Account</h2>
            <p class="text-muted mb-0">Update credentials and username for Human Resources staff.</p>
        </div>
        <a asp-action="Index" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> Back to HR
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="hrms-card p-4 p-md-5">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-4 small" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Enter HR email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Role</label>
                    <input type="text" class="form-control" value="HR" readonly />
                </div>

                <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top" style="border-color: var(--hrms-card-border) !important;">
                    <button type="submit" class="btn-hrms-primary px-4 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-hrms-outline px-4 py-2">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}