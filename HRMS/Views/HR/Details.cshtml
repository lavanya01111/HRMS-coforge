@model HRMS.Data.ApplicationUser

@{
    ViewData["Title"] = "HR Account Details";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">HR Account Details</h2>
            <p class="text-muted mb-0">Overview of administrative HR credentials and status.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-hrms-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn-hrms-outline">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="hrms-card p-4 p-md-5">

            <div class="d-flex align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--hrms-card-border) !important;">
                <div class="stat-icon-wrap stat-icon-lavender me-3" style="width: 64px; height: 64px; font-size: 28px;">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">@Model.UserName</h4>
                    <span class="badge-hrms badge-role">HR Specialist Account</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">User ID</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="font-monospace small">@Model.Id</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Username</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-semibold">@Model.UserName</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Email Address</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-semibold">@Model.Email</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Account Status</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        @if (!Model.LockoutEnd.HasValue || Model.LockoutEnd <= DateTimeOffset.UtcNow)
                        {
                            <span class="badge-hrms badge-present">Active Account</span>
                        }
                        else
                        {
                            <span class="badge-hrms badge-rejected">Inactive / Locked Out</span>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>