@model IEnumerable<HRMS.Data.ApplicationUser>

@{
    ViewData["Title"] = "HR Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">HR Management</h2>
        <p class="text-muted mb-0">View and manage HR staff user accounts and permissions.</p>
    </div>

    <a asp-controller="Admin" asp-action="Dashboard" class="btn-hrms-outline">
        <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
    </a>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">HR Accounts</h5>
            <small class="text-muted">Users with Human Resources permissions</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) HR Staff</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>User Name</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var hr in Model)
                    {
                        var isActive = !hr.LockoutEnd.HasValue || hr.LockoutEnd <= DateTimeOffset.UtcNow;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-lavender" style="width: 36px; height: 36px; font-size: 16px;">
                                        <i class="bi bi-person-workspace"></i>
                                    </div>
                                    <span class="fw-bold">@hr.Email</span>
                                </div>
                            </td>
                            <td>@hr.UserName</td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="badge-hrms badge-present">Active</span>
                                }
                                else
                                {
                                    <span class="badge-hrms badge-rejected">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <a asp-action="Details"
                                       asp-route-id="@hr.Id"
                                       class="btn-hrms-soft btn-sm"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@hr.Id"
                                       class="btn-hrms-soft btn-sm"
                                       title="Edit Account">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (isActive)
                                    {
                                        <a asp-action="Deactivate"
                                           asp-route-id="@hr.Id"
                                           class="btn-hrms-danger-soft btn-sm"
                                           title="Deactivate Account">
                                            <i class="bi bi-person-x"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate"
                                              asp-route-id="@hr.Id"
                                              method="post"
                                              class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1" style="font-size: 12px;">
                                                <i class="bi bi-person-check"></i> Activate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No HR accounts found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>