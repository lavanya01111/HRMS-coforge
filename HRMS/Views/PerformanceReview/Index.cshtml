@model IEnumerable<HRMS.Models.PerformanceReview>

@{
    ViewData["Title"] = "Performance Reviews";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">Performance Reviews</h2>
        <p class="text-muted mb-0">Record and review employee performance evaluations, ratings, and milestones.</p>
    </div>

    <a asp-action="Create" class="btn-hrms-primary">
        <i class="bi bi-star me-1"></i> Add Review
    </a>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">Evaluation Logs</h5>
            <small class="text-muted">Manager feedback and scoring</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Reviews</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Review Date</th>
                        <th>Rating</th>
                        <th>Comments</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-lavender" style="width: 32px; height: 32px; font-size: 14px;">
                                        <i class="bi bi-person-check"></i>
                                    </div>
                                    <span class="fw-bold">
                                        @(item.Employee?.EmployeeName ?? $"Employee #{item.EmployeeId}")
                                    </span>
                                </div>
                            </td>
                            <td>@item.ReviewDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge-hrms badge-approved">
                                    ★ @item.Rating / 5
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary" style="max-width: 250px; display: inline-block;">
                                    @(string.IsNullOrEmpty(item.Comments) ? "No comments" : item.Comments)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@item.PerformanceReviewId"
                                       class="btn-hrms-soft btn-sm"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.PerformanceReviewId"
                                       class="btn-hrms-soft btn-sm"
                                       title="Edit Review">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.PerformanceReviewId"
                                       class="btn-hrms-danger-soft btn-sm"
                                       title="Delete Review">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrap stat-icon-lavender mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
                <i class="bi bi-award"></i>
            </div>
            <h5 class="fw-bold mb-1">No Performance Reviews Found</h5>
            <p class="text-muted small mb-3">Add a performance review to get started.</p>
            <a asp-action="Create" class="btn-hrms-primary">
                + Add First Review
            </a>
        </div>
    }
</div>