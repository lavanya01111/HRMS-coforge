@model HRMS.ViewModels.PerformanceReview.PerformanceReviewViewModel

@{
    ViewData["Title"] = "Edit Performance Review";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Edit Performance Review</h2>
            <p class="text-muted mb-0">Modify evaluation ratings, milestones, and feedback.</p>
        </div>
        <a asp-action="Index" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> Back to Reviews
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="hrms-card p-4 p-md-5">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PerformanceReviewId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-4 small" role="alert"></div>

                <div class="row g-4">

                    <!-- Employee -->
                    <div class="col-md-6">
                        <label asp-for="EmployeeId" class="form-label">Employee</label>
                        <select asp-for="EmployeeId" class="form-select">
                            <option value="">-- Select Employee --</option>
                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.EmployeeId">@employee.EmployeeName</option>
                            }
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>

                    <!-- Review Date -->
                    <div class="col-md-6">
                        <label asp-for="ReviewDate" class="form-label">Review Date</label>
                        <input asp-for="ReviewDate" type="date" class="form-control" />
                        <span asp-validation-for="ReviewDate" class="text-danger small"></span>
                    </div>

                    <!-- Rating -->
                    <div class="col-12">
                        <label asp-for="Rating" class="form-label">Performance Rating</label>
                        <select asp-for="Rating" class="form-select">
                            <option value="1">★☆☆☆☆ (1 - Needs Immediate Improvement)</option>
                            <option value="2">★★☆☆☆ (2 - Developing)</option>
                            <option value="3">★★★☆☆ (3 - Meets Expectations)</option>
                            <option value="4">★★★★☆ (4 - Exceeds Expectations)</option>
                            <option value="5">★★★★★ (5 - Outstanding / Exceptional)</option>
                        </select>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <!-- Comments -->
                    <div class="col-12">
                        <label asp-for="Comments" class="form-label">Comments & Constructive Feedback</label>
                        <textarea asp-for="Comments" class="form-control" rows="5" placeholder="Share feedback..."></textarea>
                        <span asp-validation-for="Comments" class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top" style="border-color: var(--hrms-card-border) !important;">
                    <button type="submit" class="btn-hrms-primary px-4 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-hrms-outline px-4 py-2">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}