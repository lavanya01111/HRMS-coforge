@model HRMS.ViewModels.Employee.EmployeeViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Delete Employee</h2>
            <p class="text-muted mb-0">Confirm deletion of staff member profile.</p>
        </div>
        <a asp-action="Index" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> Cancel
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="hrms-card p-4 p-md-5">

            <div class="alert alert-warning py-3 px-4 rounded-4 mb-4 d-flex align-items-center gap-3 border-0"
                 style="background: var(--badge-warning-bg); color: var(--badge-warning-text);">
                <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                <div>
                    <strong class="d-block">Are you sure you want to delete this employee?</strong>
                    <small>This action cannot be undone and will remove the employee record.</small>
                </div>
            </div>

            <div class="p-4 rounded-4 mb-4" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="sidebar-avatar" style="width: 48px; height: 48px; font-size: 18px;">
                        @(Model.EmployeeName?.Substring(0, 1).ToUpper() ?? "E")
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">@Model.EmployeeName</h5>
                        <small class="text-muted">@Model.Designation · @Model.Email</small>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="EmployeeId" />

                <div class="d-flex gap-3">
                    <button type="submit" class="btn-hrms-danger-soft px-4 py-2">
                        <i class="bi bi-trash me-1"></i> Yes, Delete Employee
                    </button>
                    <a asp-action="Index" class="btn-hrms-outline px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>