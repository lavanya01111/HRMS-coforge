@model IEnumerable<HRMS.ViewModels.Employee.EmployeeViewModel>

@{
    ViewData["Title"] = "Employee Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">Employee Directory</h2>
        <p class="text-muted mb-0">Manage employee records, roles and organizational profiles.</p>
    </div>

    <a asp-action="Create" class="btn-hrms-primary">
        <i class="bi bi-person-plus me-1"></i> Add Employee
    </a>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">All Staff Members</h5>
            <small class="text-muted">Total registered employees</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Active</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Designation</th>
                    <th>Joining Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sidebar-avatar" style="width: 36px; height: 36px; font-size: 13px;">
                                        @(employee.EmployeeName?.Substring(0, 1).ToUpper() ?? "E")
                                    </div>
                                    <span class="fw-bold">@employee.EmployeeName</span>
                                </div>
                            </td>
                            <td>@employee.Email</td>
                            <td>@employee.PhoneNumber</td>
                            <td>
                                <span class="badge-hrms badge-info">
                                    @employee.Designation
                                </span>
                            </td>
                            <td>@employee.JoiningDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@employee.EmployeeId"
                                       class="btn-hrms-soft btn-sm"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@employee.EmployeeId"
                                       class="btn-hrms-soft btn-sm"
                                       title="Edit Record">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@employee.EmployeeId"
                                       class="btn-hrms-danger-soft btn-sm"
                                       title="Delete Record">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No employees found. Click "Add Employee" to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>