@model IEnumerable<HRMS.ViewModels.Payroll.PayrollViewModel>

@{
    ViewData["Title"] = "Payroll Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold font-serif mb-1">Payroll Management</h2>
        <p class="text-muted mb-0">Manage and process employee compensation records and monthly statements.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn-hrms-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Payroll
        </a>
        <a asp-controller="HRDashboard" asp-action="Index" class="btn-hrms-outline">
            <i class="bi bi-arrow-left me-1"></i> HR Dashboard
        </a>
    </div>
</div>

<div class="hrms-table-container p-0">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--hrms-card-border) !important;">
        <div>
            <h5 class="fw-bold mb-0">Payroll Statements</h5>
            <small class="text-muted">Generated monthly records</small>
        </div>
        <span class="badge-hrms badge-role">@(Model?.Count() ?? 0) Records</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Salary Month</th>
                        <th>Basic Salary</th>
                        <th>Allowance</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payroll in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrap stat-icon-peach" style="width: 32px; height: 32px; font-size: 14px;">
                                        <i class="bi bi-wallet2"></i>
                                    </div>
                                    <span class="fw-bold">
                                        @(string.IsNullOrEmpty(payroll.EmployeeName)
                                            ? $"Employee #{payroll.EmployeeId}"
                                            : payroll.EmployeeName)
                                    </span>
                                </div>
                            </td>
                            <td>@payroll.SalaryMonth.ToString("MMM yyyy")</td>
                            <td>₹@payroll.BasicSalary.ToString("N2")</td>
                            <td class="text-success">+₹@payroll.Allowance.ToString("N2")</td>
                            <td class="text-danger">-₹@payroll.Deduction.ToString("N2")</td>
                            <td>
                                <span class="badge-hrms badge-approved">
                                    ₹@payroll.NetSalary.ToString("N2")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@payroll.PayrollId"
                                       class="btn-hrms-soft btn-sm"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@payroll.PayrollId"
                                       class="btn-hrms-soft btn-sm"
                                       title="Edit Record">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@payroll.PayrollId"
                                       class="btn-hrms-danger-soft btn-sm"
                                       title="Delete Record">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrap stat-icon-peach mx-auto mb-3" style="width: 60px; height: 60px; font-size: 26px;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h5 class="fw-bold mb-1">No Payroll Records Found</h5>
            <p class="text-muted small mb-3">Click "Add Payroll" to issue the first employee salary record.</p>
            <a asp-action="Create" class="btn-hrms-primary">
                + Add Payroll Record
            </a>
        </div>
    }
</div>