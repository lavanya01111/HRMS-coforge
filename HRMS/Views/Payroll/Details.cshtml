@model HRMS.ViewModels.Payroll.PayrollViewModel

@{
    ViewData["Title"] = "Payroll Details";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Payroll Statement Details</h2>
            <p class="text-muted mb-0">Itemized compensation overview.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PayrollId" class="btn-hrms-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn-hrms-outline">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="hrms-card p-4 p-md-5">

            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--hrms-card-border) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrap stat-icon-peach" style="width: 52px; height: 52px; font-size: 24px;">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">
                            @(string.IsNullOrEmpty(Model.EmployeeName) ? $"Employee #{Model.EmployeeId}" : Model.EmployeeName)
                        </h4>
                        <small class="text-muted">Salary Month: @Model.SalaryMonth.ToString("MMMM yyyy")</small>
                    </div>
                </div>

                <span class="badge-hrms badge-approved fs-6">
                    Net: ₹@Model.NetSalary.ToString("N2")
                </span>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label text-muted small text-uppercase fw-bold">Basic Salary</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-bold">₹@Model.BasicSalary.ToString("N2")</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted small text-uppercase fw-bold">Allowances</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-bold text-success">+₹@Model.Allowance.ToString("N2")</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted small text-uppercase fw-bold">Deductions</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-bold text-danger">-₹@Model.Deduction.ToString("N2")</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>