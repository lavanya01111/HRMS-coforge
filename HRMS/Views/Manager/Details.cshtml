@model HRMS.Models.Manager

@{
    ViewData["Title"] = "Manager Details";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold font-serif mb-1">Manager Details</h2>
            <p class="text-muted mb-0">Overview of leadership credentials and assigned department.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ManagerId" class="btn-hrms-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn-hrms-outline">
                <i class="bi bi-arrow-left me-1"></i> Back to Managers
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Profile Left -->
    <div class="col-lg-8">
        <div class="hrms-card p-4 h-100">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--hrms-card-border) !important;">
                <div class="sidebar-avatar me-3" style="width: 72px; height: 72px; font-size: 28px;">
                    @(Model.ManagerName?.Substring(0, 1).ToUpper() ?? "M")
                </div>
                <div>
                    <h4 class="fw-bold mb-1">@Model.ManagerName</h4>
                    <span class="badge-hrms badge-role">@Model.Designation</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Email Address</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-semibold">@Model.Email</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Phone Number</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-semibold">@Model.PhoneNumber</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Joining Date</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="fw-semibold">@Model.JoiningDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small text-uppercase fw-bold">Status</label>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.02); border: 1px solid var(--hrms-card-border);">
                        <span class="badge-hrms badge-present">Active Account</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Department Right -->
    <div class="col-lg-4">
        <div class="hrms-card p-4 h-100 text-center d-flex flex-column align-items-center justify-content-center">
            <div class="stat-icon-wrap stat-icon-mint mx-auto mb-3" style="width: 60px; height: 60px; font-size: 28px;">
                <i class="bi bi-building"></i>
            </div>
            <label class="form-label text-muted small text-uppercase fw-bold mb-1">Assigned Department</label>
            @if (Model.Department != null)
            {
                <h4 class="fw-bold mb-1">@Model.Department.DepartmentName</h4>
                <p class="text-muted small mb-0">@Model.Department.Description</p>
            }
            else
            {
                <span class="text-muted">No Department Assigned</span>
            }
        </div>
    </div>
</div>
