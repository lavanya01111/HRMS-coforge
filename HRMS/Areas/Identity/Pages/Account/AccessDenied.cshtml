@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4 p-md-5 text-center shadow-sm">
                <div class="stat-icon mx-auto mb-3" style="background: rgba(225, 29, 72, 0.1); color: #e11d48; width: 64px; height: 64px; font-size: 1.75rem;">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h2 class="fw-bold mb-2">Access Denied</h2>
                <p class="text-muted mb-4">You do not have permission or role privileges to access this resource or page.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-custom">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
