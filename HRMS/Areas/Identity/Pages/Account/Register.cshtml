@page
@model RegisterModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Account";
}

<div class="auth-split-wrapper">

    <div class="auth-split-container" style="max-width: 1140px;">

        <!-- LEFT PANEL -->
        <div class="auth-side-brand">

            <div class="auth-brand-logo">
                <div class="auth-brand-icon">
                    ♡
                </div>
                <div>
                    <strong class="d-block fs-5" style="letter-spacing: 0.5px;">HRMS</strong>
                    <small style="letter-spacing: 2px; font-size: 9px; opacity: 0.85;">WORKFORCE HUB</small>
                </div>
            </div>

            <div class="auth-side-content">
                <h2 class="auth-side-title">
                    Create your<br />
                    <span>workspace.</span>
                </h2>

                <p class="auth-side-desc">
                    Join your organization and become part of a better, simpler and more connected workplace experience.
                </p>

                <div class="auth-feature-list">
                    <div class="auth-feature-item">
                        <i class="bi bi-person-check"></i>
                        <span>Seamless Employee Onboarding</span>
                    </div>
                    <div class="auth-feature-item">
                        <i class="bi bi-clock-history"></i>
                        <span>Instant Attendance & Time Off</span>
                    </div>
                    <div class="auth-feature-item">
                        <i class="bi bi-cash-coin"></i>
                        <span>Transparent Payroll Tracking</span>
                    </div>
                </div>
            </div>

            <div class="auth-side-quote">
                ♡ &nbsp; Your information helps us create your personalized employee workspace.
            </div>

        </div>


        <!-- RIGHT FORM PANEL -->
        <div class="auth-form-panel" style="padding: 42px 48px;">

            <div class="mb-4">
                <h3 class="auth-form-title">Create Account</h3>
                <p class="auth-form-subtitle">Enter your details to register as an employee.</p>
            </div>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 px-3 mb-3 small"
                     role="alert">
                </div>

                <div class="row g-3">

                    <!-- EMPLOYEE NAME -->
                    <div class="col-md-6">
                        <label asp-for="Input.EmployeeName" class="form-label">
                            Employee Name
                        </label>
                        <input asp-for="Input.EmployeeName"
                               class="form-control"
                               placeholder="e.g. Sarah Jenkins" />
                        <span asp-validation-for="Input.EmployeeName" class="text-danger small"></span>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label">
                            Work Email
                        </label>
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="sarah@company.com"
                               autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- PHONE -->
                    <div class="col-md-6">
                        <label asp-for="Input.PhoneNumber" class="form-label">
                            Phone Number
                        </label>
                        <input asp-for="Input.PhoneNumber"
                               class="form-control"
                               placeholder="+1 (555) 000-0000" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <!-- DESIGNATION -->
                    <div class="col-md-6">
                        <label asp-for="Input.Designation" class="form-label">
                            Designation
                        </label>
                        <input asp-for="Input.Designation"
                               class="form-control"
                               placeholder="e.g. Software Developer" />
                        <span asp-validation-for="Input.Designation" class="text-danger small"></span>
                    </div>

                    <!-- JOINING DATE -->
                    <div class="col-md-6">
                        <label asp-for="Input.JoiningDate" class="form-label">
                            Joining Date
                        </label>
                        <input asp-for="Input.JoiningDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="Input.JoiningDate" class="text-danger small"></span>
                    </div>

                    <!-- DEPARTMENT -->
                    <div class="col-md-6">
                        <label asp-for="Input.DepartmentId" class="form-label">
                            Department
                        </label>
                        <select asp-for="Input.DepartmentId"
                                asp-items="ViewBag.Departments"
                                class="form-select">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="Input.DepartmentId" class="text-danger small"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="col-md-6">
                        <label asp-for="Input.Password" class="form-label">
                            Password
                        </label>
                        <input asp-for="Input.Password"
                               type="password"
                               class="form-control"
                               placeholder="Create password"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="col-md-6">
                        <label asp-for="Input.ConfirmPassword" class="form-label">
                            Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm password"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4 pt-2">
                    <button type="submit"
                            class="btn-hrms-primary w-100 py-3 mb-3">
                        Create Account
                    </button>
                </div>

                <div class="text-center">
                    <span class="text-muted" style="font-size: 13px;">Already have an account?</span>
                    <a asp-page="./Login" class="fw-semibold ms-1" style="color: var(--hrms-primary); font-size: 13px;">
                        Login here
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}