@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4 p-md-5 text-center shadow-sm">
                <div class="stat-icon mx-auto mb-3" style="background: rgba(193, 91, 128, 0.12); color: var(--primary); width: 64px; height: 64px; font-size: 1.75rem;">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <h2 class="fw-bold mb-2">Check Your Inbox</h2>
                <p class="text-muted mb-4">We've sent a link to reset your password if an account exists for that address. Please check your inbox and spam folder.</p>
                <div>
                    <a asp-page="./Login" class="btn btn-custom">
                        <i class="bi bi-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
