@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4 p-md-5 text-center shadow-sm">
                <div class="stat-icon mx-auto mb-3" style="background: rgba(34, 197, 94, 0.12); color: #16a34a; width: 64px; height: 64px; font-size: 1.75rem;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <h2 class="fw-bold mb-2">Password Reset!</h2>
                <p class="text-muted mb-4">Your password has been successfully updated. You can now sign in with your new credentials.</p>
                <div>
                    <a asp-page="./Login" class="btn btn-custom">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Proceed to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
