@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked Out";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4 p-md-5 text-center shadow-sm">
                <div class="stat-icon mx-auto mb-3" style="background: rgba(225, 29, 72, 0.1); color: #e11d48; width: 64px; height: 64px; font-size: 1.75rem;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h2 class="fw-bold mb-2">Account Locked Out</h2>
                <p class="text-muted mb-4">This account has been temporarily locked out due to multiple failed login attempts. Please try again later or contact your administrator.</p>
                <div>
                    <a asp-page="./Login" class="btn btn-custom">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Return to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
