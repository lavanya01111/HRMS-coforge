@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card p-4 p-md-5 text-center shadow-sm">
                <div class="stat-icon mx-auto mb-3" style="background: rgba(225, 29, 72, 0.1); color: #e11d48; width: 64px; height: 64px; font-size: 1.75rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h2 class="fw-bold mb-2">Something Went Wrong</h2>
                <p class="text-muted mb-4">An unexpected authentication or system error occurred while processing your request.</p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-2 px-3 rounded-pill d-inline-block mx-auto mb-4" style="background: var(--bg-body); border: 1px solid var(--border-color); font-size: 0.85rem;">
                        <span class="text-muted">Request ID:</span> <code class="fw-bold" style="color: var(--primary);">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-custom">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-custom">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
